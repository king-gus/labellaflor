{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "labellaflor",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    // Next/OpenNext + Neon: evita 500 "promise was created by a request that has since ended"
    "no_handle_cross_request_promise_resolution"
  ],
  "workers_dev": true,
  // Roda o Worker perto do Neon em São Paulo (América do Sul)
  "placement": {
    "mode": "targeted",
    "region": "aws:sa-east-1"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "labellaflor"
    }
  ],
  "routes": [
    {
      "pattern": "www.labellaflorboutique.com.br",
      "custom_domain": true,
      "zone_name": "labellaflorboutique.com.br"
    },
    {
      "pattern": "labellaflorboutique.com.br",
      "custom_domain": true,
      "zone_name": "labellaflorboutique.com.br"
    }
  ],
  // R2: após Enable no dashboard — bucket em jurisdição padrão (R2 sem SA dedicada)
  // "images": { "binding": "IMAGES" },
  // "r2_buckets": [
  //   { "binding": "PRODUCT_IMAGES", "bucket_name": "labellaflor-products" }
  // ],
  "observability": {
    "enabled": true
  }
}
