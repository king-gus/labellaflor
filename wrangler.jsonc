{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "labellaflor",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "labellaflor"
    }
  ],
  // Custom Domains: reativar depois de Add Site + nameservers Active
  // "routes": [
  //   { "pattern": "www.labellaflorboutique.com.br", "custom_domain": true },
  //   { "pattern": "labellaflorboutique.com.br", "custom_domain": true }
  // ],
  // R2: reativar após habilitar R2 no dashboard da cliente
  // (Dashboard → R2 → Enable → bucket labellaflor-products)
  // "images": { "binding": "IMAGES" },
  // "r2_buckets": [
  //   { "binding": "PRODUCT_IMAGES", "bucket_name": "labellaflor-products" }
  // ],
  "observability": {
    "enabled": true
  }
}
